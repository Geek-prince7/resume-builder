# Choose AI provider: "openai" or "gemini"
AI_PROVIDER=openai
APP_ENV=testapp
LOG_LEVEL=info
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=resume-builder-testapp
CLOUDWATCH_AI_LOG_STREAM=ai-service-testapp

# OpenAI config (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Gemini config (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
