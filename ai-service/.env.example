# Choose AI provider: "openai" or "gemini"
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini
PROMPT_VERSION=2026-08-truthful-v1
APP_ENV=dev
LOG_LEVEL=info
AWS_REGION=us-east-1
CLOUDWATCH_LOG_GROUP=resume-builder-dev
CLOUDWATCH_AI_LOG_STREAM=ai-service-dev
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_HOSTS=localhost,127.0.0.1,ai-service,backend
AI_RATE_LIMIT_WINDOW_SECONDS=60
AI_RATE_LIMIT_MAX_REQUESTS=30
MAX_RESUME_FILE_SIZE_BYTES=5242880
MAX_RESUME_TEXT_CHARS=120000
MAX_JD_CHARS=30000
LLM_RETRY_ATTEMPTS=3
LLM_RETRY_BASE_DELAY_MS=250
LLM_RETRY_MAX_DELAY_MS=3000
LLM_RETRY_JITTER_MS=300
LLM_REQUEST_TIMEOUT_SECONDS=45
LLM_MAX_OUTPUT_TOKENS=5000

# OpenAI config (used when AI_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini

# Gemini config (used when AI_PROVIDER=gemini)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.0-flash
